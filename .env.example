# Database (Supabase: Connect → Transaction pooler URI, port 6543)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lookgooder

# Storage: "local" for development, "supabase" in production
STORAGE_DRIVER=local
STORAGE_DIR=.data/storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=look-gooder

# Sign-in
APP_PASSWORD=
SESSION_SECRET=   # 40+ random characters
